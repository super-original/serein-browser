{
  "manifest_version": 2,
  "name": "Serein MV2 network fixture",
  "version": "1.0",
  "permissions": [
    "cookies",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "description": "Original loopback-only network and cookie permission conformance fixture."
}
