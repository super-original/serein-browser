{
  "manifest_version": 2,
  "name": "Serein MV2 isolated native bridge probe",
  "version": "1.0.0",
  "permissions": [
    "nativeMessaging",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "description": "Controlled protocol probe with no native program, file, or browser-data access."
}
