{
  "manifest_version": 2,
  "name": "Serein MV2 conformance fixture",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "tabs",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html"
  },
  "description": "Controlled Serein integration fixture for extension lifecycle, permissions, storage and messaging."
}
